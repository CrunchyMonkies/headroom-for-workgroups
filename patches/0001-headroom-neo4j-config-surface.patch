diff --git a/headroom/memory/neo4j_env.py b/headroom/memory/neo4j_env.py
new file mode 100644
index 0000000..dea21b6
--- /dev/null
+++ b/headroom/memory/neo4j_env.py
@@ -0,0 +1,57 @@
+"""Resolve Neo4j connection settings from environment variables.
+
+Companion to :mod:`headroom.memory.qdrant_env`. The ``qdrant-neo4j`` memory
+backend needs both halves of its connection configured, but only the Qdrant
+half was reachable from the environment — the Neo4j half was hardcoded to
+``neo4j://localhost:7687``. That made the backend unusable from any
+containerised deployment (Docker Compose, Kubernetes), where Neo4j is a
+separate service rather than a loopback process.
+
+Supported environment variables:
+
+- ``HEADROOM_NEO4J_URI``       Bolt URI (e.g. ``neo4j://neo4j.svc:7687``).
+                                Default: ``neo4j://localhost:7687``.
+- ``HEADROOM_NEO4J_USER``      Username. Default: ``neo4j``.
+- ``HEADROOM_NEO4J_PASSWORD``  Password. Default: empty (the proxy logs a
+                                warning when the ``qdrant-neo4j`` backend is
+                                selected without one).
+
+Explicit constructor arguments and CLI flags always win over environment
+values; these only fill in dataclass defaults.
+"""
+
+from __future__ import annotations
+
+import os
+
+DEFAULT_NEO4J_URI = "neo4j://localhost:7687"
+DEFAULT_NEO4J_USER = "neo4j"
+
+
+def _strip_env(name: str) -> str | None:
+    """Return the trimmed env var value, or ``None`` if unset/empty."""
+    raw = os.environ.get(name)
+    if raw is None:
+        return None
+    stripped = raw.strip()
+    return stripped or None
+
+
+def neo4j_env_uri() -> str:
+    """Return ``HEADROOM_NEO4J_URI`` or the ``neo4j://localhost:7687`` default."""
+    return _strip_env("HEADROOM_NEO4J_URI") or DEFAULT_NEO4J_URI
+
+
+def neo4j_env_user() -> str:
+    """Return ``HEADROOM_NEO4J_USER`` or the ``neo4j`` default."""
+    return _strip_env("HEADROOM_NEO4J_USER") or DEFAULT_NEO4J_USER
+
+
+def neo4j_env_password() -> str:
+    """Return ``HEADROOM_NEO4J_PASSWORD`` or an empty string if unset.
+
+    Empty (rather than ``None``) keeps the ``ProxyConfig.memory_neo4j_password``
+    field a plain ``str``, so the existing "password is not set" startup warning
+    in the proxy continues to work unchanged.
+    """
+    return _strip_env("HEADROOM_NEO4J_PASSWORD") or ""
