# Upstream base for the patches in this directory.
#
# This file is the single source of truth for what we build the patched Headroom
# image from. Both .github/workflows/ci.yml (which checks the patch still
# applies) and .github/workflows/release.yml (which builds and publishes the
# image) source it, and patches/README.md documents it rather than restating the
# commit.
#
# Re-basing onto a newer upstream: bump HEADROOM_BASE_COMMIT, re-generate any
# patch that no longer applies cleanly, and let CI's `patch` job confirm it.
#
# HEADROOM_PATCHES is a space-separated list applied IN ORDER. Each one is
# generated against the tree with its predecessors already applied, so the
# order here is the order they must be applied in — do not sort it.
#
# Shell-sourceable: plain KEY=value, no expansion. The list is quoted because
# it contains spaces; everything reading it must quote the expansion or split
# it deliberately.

HEADROOM_REPO=headroomlabs-ai/headroom
HEADROOM_BASE_COMMIT=941c25d31e6c6e0b436c307cbe212771ff76b45f
HEADROOM_PATCHES="patches/0001-headroom-neo4j-config-surface.patch patches/0002-headroom-mem0-2x-search-api.patch patches/0003-headroom-direct-write-payload-key.patch"
